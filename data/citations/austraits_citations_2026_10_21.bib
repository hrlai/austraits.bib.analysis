    author = {Thompson, Jamie B. and Martinez, Catherine and Avaria‐Llautureo, Jorge and Ramírez‐Barahona, Santiago and Manzanarez-Villasana, Gerardo and Culham, Alastair and Gdaniec, Andrew and Ryan, George and Venditti, Chris and Keeling, Georgia and Priest, Nicholas K.},
