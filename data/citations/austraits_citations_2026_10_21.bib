@article{tangney2025defining,
    title = {Defining the pyro‐thermal niche: do seed traits, ecosystem type and phylogeny influence thermal thresholds in seeds with physical dormancy?},
    author = {Tangney, Ryan James and McInnes, Sarah J. and Dalziell, Emma L. and Cornwell, William K. and Miller, Ben P. and Auld, Tony D. and Ooi, Mark K. J.},
    year = {2025},
    journal = {New Phytologist},
