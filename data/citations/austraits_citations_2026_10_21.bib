@article{vogado2026seasonal,
    title = {Seasonal and long-term patterns of reproductive phenology in the Wet Tropics rainforests of Australia},
    author = {Vogado, Nara Oliveira and Engert, Jayden E. and Liddell, Michael J.},
    year = {2026},
    journal = {Web Ecology},
    volume = {26},
    number = {2},
    pages = {175--192},
    issn = {1399-1183},
    doi = {10.5194/we-26-175-2026},
    url = {https://doi.org/10.5194/we-26-175-2026},
    language = {en},
    keywords = {reproductive phenology, flowering, fruiting, tropical rainforest, Wet Tropics, seasonal patterns, seed size, phenological calendar, forest restoration},
    abstract = {Understanding reproductive phenology in tropical rainforests is important for predicting forest dynamics, ecosystem processes, and forest vulnerability. Long-term plant phenology datasets from tropical rainforests are relatively rare, particularly in Oceania. Here, canopy observations collected by a single observer using a forest gondola system generated a 15-year weekly flowering and fruiting dataset of 132 species in the Wet Tropics of Queensland, Australia. Using this dataset, we investigated seasonal and long-term reproductive phenology at the community and species level. At the community level, flowering was strongly seasonal and concentrated in the wet season, while fruiting showed weaker seasonality and was generally concentrated in the dry season. The timing of peak flowering and fruiting activity differed between abiotic and biotic groups. Over the 15-year study period, some species advanced or delayed flowering and fruiting. Flowering timing was largely stable across both biotically and abiotically dispersed species, with most species showing no significant change. Changes in fruiting timing were more common among biotically dispersed species, including both advances and delays, whereas most abiotically dispersed species showed no significant change. Annual cycles were most common in flowering, whereas supra-annual cycles were predominant in fruiting. At the species level, reproductive activity occurred throughout the year but varied markedly in timing, with many species displaying supra-annual flowering and fruiting. Supra-annual flowering was more likely in biotically dispersed species, while supra-annual fruiting was more likely in species with larger seeds. Finally, we present the first comprehensive phenological calendar for 81 tree species in the Wet Tropics rainforests of Queensland. These findings provide a foundation for future ecological research and restoration practice in the region.},
}

@article{ignacio2026soil,
    title = {Soil Seed Bank Holds Some Potential for Natural Regeneration in a Semi‐Arid Rangeland},
    author = {Ignacio, Bettina and Moles, Angela T. and Offord, Catherine A. and Chiarenza, Giancarlo Maria and Maslen, Ben and Hemmings, Frank A. and Leggett, Keith and Xirocostas, Zoe A.},
    year = {2026},
    journal = {Austral Ecology},
    volume = {51},
    number = {8},
    issn = {1442-9985},
    doi = {10.1111/aec.70278},
    url = {https://doi.org/10.1111/aec.70278},
    language = {en},
    keywords = {soil seed bank, natural regeneration, semi-arid rangelands, Acacia aneura, mulga, chenopod shrubland, gibberellic acid, introduced species, grazing intensity, distance to water, seed bank density, ecological restoration},
    abstract = {ABSTRACT Natural regeneration of degraded lands can be facilitated by the recruitment of plant species from the soil seed bank. However, the composition of soil seed banks in arid Australia has seldom been studied. We addressed this knowledge gap by quantifying the soil seed bank of chenopod shrubland and remnant Acacia aneura (mulga) stands in an ex‐agricultural site in New South Wales, Australia. We also assessed the effect of three germination pre‐treatments. Overall, the soil seed bank yielded 113 species, only 11 of which (14\%) were introduced species. Despite mulga historically being a dominant canopy species at our site, we found no evidence that it has a viable seed bank. Distance from water troughs (a proxy for past grazing intensity) did not affect seed bank richness or diversity, but seed bank density doubled between 16 m and 1024 m. Samples treated with gibberellic acid solution and controls (water only) produced a similar density of germinants (4843 vs. 4337 seedlings m −2 ), while soil samples treated with hot water yielded only 1118 seedlings m −2 . Our results suggest a substantial and diverse native seed bank exists for natural regeneration, but some key species will not return without ecological restoration .},
}

@article{lanceman2026restoration,
    title = {Restoration transforms coastal wetland ecosystem services over time},
    author = {Lanceman, Dana and Glamore, William C. and Slavich, Eve and Mayer‐Pinto, Mariana},
    year = {2026},
    journal = {Ecological Applications},
    volume = {36},
    number = {6},
    pages = {e70292},
    issn = {1051-0761},
    doi = {10.1002/eap.70292},
    url = {https://doi.org/10.1002/eap.70292},
    language = {en},
    keywords = {habitat restoration, coastal wetlands, ecosystem services, functional traits, mangroves, salt marshes, temporal trajectories, space-for-time, estuaries, restoration monitoring},
    abstract = {Habitat restoration is increasing globally, aiming to recover biodiversity and ecosystem services. To assess the success and value of such restoration projects, we need to understand how and when they produce desired restoration outcomes. However, there is currently limited data-driven understanding of how biodiversity and ecosystem services develop over extended timescales (e.g., decades) following restoration. While ecosystem services can be challenging to quantify, functional traits can be used as effective proxies that are more easily measured. Here, we employed a space-for-time approach at multiple restored sites (6-33 years old) in two estuaries in eastern Australia (Hunter River estuary and Maroochy River estuary) to explore temporal trajectories of functional traits in coastal wetlands. We found diverse, often nonlinear temporal trends for numerous functional traits in mangrove and saltmarsh habitats, including saltmarsh cover, saltmarsh burrows, mangrove height, and mangrove saplings, all of which directly link to ecosystem services. Further understanding of ecosystem service changes after restoration can inform ongoing monitoring and management, which may improve predictions of recovery timescales. These will help refine restoration goals and manage project expectations, thereby increasing future restoration success.},
}

@article{lee2026predicting,
    title = {Predicting decay in functional diversity in plant communities under future climates},
    author = {Lee, Joshua S. and Cornwell, William K. and Teckentrup, Lina and Brazill‐Boast, James and Gallagher, Rachael V.},
    year = {2026},
    journal = {Ecological Indicators},
    volume = {191},
    pages = {115545},
    issn = {1470-160X},
    doi = {10.1016/j.ecolind.2026.115545},
    url = {https://doi.org/10.1016/j.ecolind.2026.115545},
    language = {en},
    keywords = {functional diversity, plant communities, climate change, future climate scenarios, plant functional traits},
    abstract = {Climate change is expected to cause widespread shifts in the composition of plant communities. However, the extent to which these changes will alter the composition and diversity of plant functional traits is less clear. Here, we assess how climate change may reshape the functional diversity of 32,996 plant communities by combining data on their traits and realised climatic niches with future climate projections. We find that under projected climates for the decade centred on 2070, in most plots, over a third of species will experience conditions outside of their current realised climatic niches. Yet, typically, the projected removal of these species from communities represented a decay in functional diversity of 11.6\%, indicating some functional redundancy. We found that climate-filtered species removal resulted in a marginally greater loss of functional diversity (+1.69\%) compared to random species removal. Patterns of relative functional decay (i.e., projected loss of functional diversity relative to climate-filtered species removal under future climate) were distinct between woody and non-woody species, with woody species being at higher risk of declines in functional diversity. These results highlight the importance of integrating additional metrics, such as functional diversity and functional decay, into conservation and restoration planning to characterise vulnerable communities and growth forms. Using a functional dimension of biodiversity can help conservation practitioners identify areas vulnerable to climate change, inform management actions, and prioritise the restoration of key growth forms to reinstate ecosystem function and identity.},
}

@article{simpsonyoung2026cultivating,
    title = {Cultivating diversity: is the functional diversity of nursery stocks sufficient for the establishment of functionally diverse restored woodlands?},
    author = {Simpson-Young, Charlotte and Atkinson, Joe and Bonser, Stephen Patrick},
    year = {2026},
    journal = {Restoration Ecology},
    issn = {1061-2971},
    doi = {10.1111/rec.70562},
    url = {https://doi.org/10.1111/rec.70562},
    language = {en},
    keywords = {nursery stock, functional diversity, ecological restoration, functional traits, seed weight, resprouting species, seed dispersal, vegetative propagation, national parks, species representation},
    abstract = {Abstract Introduction Ecological restoration projects often rely on nurseries (NU) to provide plants to restore ecological communities. However, the range of species available in NU may not represent the range of ecological function found in species in reference (natural) communities. Objectives We tested for differences in species and functional representation between national parks (NP; reference communities) and NU used to supply plants for restoration projects. Methods We conducted vegetation surveys in 14 NP sites in the Sydney basin. Each community surveyed represented Sydney Dry Sclerophyll Woodland. Further, we surveyed the species found in 10 plant NU that provide stock for restoration projects in nearby woodlands of the same ecosystem. Functional traits (e.g. seed mass and plant height) for each species were obtained from established functional trait databases. Results We found that NU had fewer species than those from reference communities. NU had a higher representation of trees, species with a longer juvenile period, and a lower representation of herbs and subshrubs. Post‐fire response traits were different, with an under‐representation of resprouting species. Biotically and mixed biotically–abiotically dispersed species, and species with dry fruit, leaf specializations, and capacity for vegetative reproduction were under‐represented. Conclusion While NU remain a valuable resource for restoration projects, the range of functional traits found in NU could limit restoration success.},
}

@article{johnstonbates2026patterns,
    title = {Patterns of plant invasion in disturbed dryland riverine ecosystems},
    author = {Johnston‐Bates, Jaiden and Sheldon, Fran and Catford, Jane A. and Grieger, Rebekah and Zivec, Peta and Capon, Samantha J.},
    year = {2026},
    journal = {Agriculture Ecosystems \& Environment},
    volume = {414},
    pages = {110778},
    issn = {0167-8809},
    doi = {10.1016/j.agee.2026.110778},
    url = {https://doi.org/10.1016/j.agee.2026.110778},
    language = {en},
    keywords = {plant invasion, non-native plants, riparian vegetation, disturbance, invasion patterns},
    abstract = {Plant invasions can be facilitated by natural or anthropogenic disturbance. Non-native plant invasion is therefore expected to be especially high where land that is used for agriculture intersects with disturbance-prone riparian ecosystems. We investigated patterns and drivers of plant invasion in the semi-arid agricultural region of the northern Murray-Darling Basin in eastern Australia. We surveyed the floodplain and riparian vegetation at 22 sites, recording all strata and cover of plant taxa, which we categorised by biogeographic origin (native/non-native) and growth form. We found that native species were dominant in the standing vegetation of the surveyed sites and were represented by a breadth of growth forms across all structural canopy layers. Non-native grasses, forbs and shrubs were also prominent, comprising at least 30\% of all recorded species. On occasion, the majority of vegetative cover (up to 90\%) in surveyed sites was made up of non-native grasses or forbs. Non-native trees were rare, with just one taxon ( Salix sp.) recorded at a single site, indicating that dispersal and other ecological constraints have restricted establishment. Native and non-native species composition did not vary significantly between habitat types (riparian versus floodplain), suggesting that the species pool of this region is largely comprised of habitat generalists. Dryland riparian ecosystems are complex, dynamic and variable, subject to an array of natural and anthropogenic pressures. Plant invasion appeared to be shaped by an interplay of factors, including catchment geography, site-based variability, land use and hydrology, with the importance of environmental drivers varying among habitat type and between native and non-native assemblages. Environmental management that addresses the drivers of native species decline and non-native invasion will be important for preserving dominance of native vegetation in floodplain and riparian ecosystems of the northern Murray-Darling Basin.},
}

@article{katori2026mining,
    title = {Mining buried plant trait data from the Global Biodiversity Information Facility (GBIF): Comparison and integration with multiple plant trait databases},
    author = {Katori, Takuro and Oguro, Michio},
    year = {2026},
    journal = {Applications in Plant Sciences},
    pages = {e70083},
    issn = {2168-0450},
    doi = {10.1002/aps3.70083},
    url = {https://doi.org/10.1002/aps3.70083},
    language = {en},
    keywords = {plant functional traits, GBIF, text mining, digital texts, vascular plants, lifespan, plant habit, flower color, data integration},
    abstract = {Abstract Premise Despite the availability of several plant trait databases, significant traits remain undocumented for a substantial number of species. To address this issue, the current study explored digital text from the Global Biodiversity Information Facility (GBIF) as an innovative source of plant trait information and evaluated its capacity to reduce existing deficiencies. Methods Data were gathered on lifespan ( LS ), growth form ( GF ), flower color ( FC ), and maximum plant height ( PH max ) for vascular plants from GBIF and four common plant trait databases. The resulting dataset was used to evaluate the novelty and consistency of trait values derived from GBIF's digital text relative to those from other databases. Results Incorporation of GBIF‐extracted trait data led to increases of 1.2‐, 1.2‐, 5.5‐, and 2.7‐fold in the number of species with documented LS , GF , FC , and PH max traits, respectively. GBIF's trait data demonstrated high congruence with other databases, except in the case of FC . Additionally, a comprehensive dataset compiling these trait values from GBIF and the four databases was created, offering a valuable resource for future plant trait research. Discussion Our findings suggest that digital text in GBIF represents a significant source of plant trait information and can effectively help bridge information gaps.},
}

@article{andres2026framework,
    title = {A framework for cost‐effective scalable revegetation planning: Experimental evidence of early establishment using native grass species},
    author = {Andres, Samantha E. and Alfonzetti, Matthew and Adams, Vanessa M. and Mills, Charlotte H. and Lieurance, Paige E. and Tetu, Sasha G. and Gallagher, Rachael V.},
    year = {2026},
    journal = {Conservation Science and Practice},
    issn = {2578-4854},
    doi = {10.1111/csp2.70420},
    url = {https://doi.org/10.1111/csp2.70420},
    language = {en},
    keywords = {cost-effectiveness, native grasses, grassland restoration, early establishment, direct seeding, theory of change, project scale, weed cover, adaptive management},
    abstract = {Abstract To ensure the effective allocation of funding, revegetation projects require transparent and integrated evaluations of costs and benefits. Yet, these elements are commonly omitted or reported separately, leaving stakeholders with an incomplete picture of the resourcing required to plan effective interventions at scale. Here, we present findings from an experimental field trial establishing native grasses using three planting interventions (direct seeding, pelletized seeding, and tubestock seedlings) interpolated to three project scale scenarios (1, 10, and 100 ha). Our experiment was designed to simultaneously quantify key revegetation costs and early establishment benefits in grassland restoration. To guide our choice of empirical measures of costs and benefits, we developed theories of change (ToC) which explicitly link intervention activities to predicted outcomes and resource inputs. Our ToC allows for outcomes observed in the field to be mapped to predictions underpinning an intervention's success and guide adaptive management and planning. While the cost‐effectiveness of each planting intervention improved with increasing project scale scenario, costs and outcomes significantly differed between interventions. As expected, seed‐based interventions provided the most cost‐effective and scalable establishment outcomes compared to tubestock plantings. Tubestock, while more expensive to implement, yielded lower weed cover and more uniform establishment across target species—benefits that may justify higher costs depending on a project's early establishment goals. Our 7‐month early establishment monitoring period would benefit from complementary long‐term data to inform future decision‐making.},
}

