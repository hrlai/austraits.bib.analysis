@article{giolai2024trade,
    title = {A trade-off between investment in molecular defense repertoires and growth in plants},
    author = {Giolai, Michael and Laine, Anna‐Liisa},
    year = {2024},
    journal = {Science},
    volume = {386},
    number = {6722},
    pages = {677--680},
    issn = {0036-8075},
    doi = {10.1126/science.adn2779},
    url = {https://doi.org/10.1126/science.adn2779},
    language = {en},
    keywords = {growth-defense trade-off, plant immunity, nucleotide-binding leucine-rich repeat receptors, plant growth, plant domestication, wild vs cultivated plants, plant-pathogen interaction, trait variation},
    abstract = {Given the negative fitness effects that pathogens impose on their hosts, the benefits of resistance should be universal. However, there is marked variation across plant species in the number of nucleotide-binding leucine-rich repeat receptors, which form a cornerstone of defense. The growth-defense trade-off hypothesis predicts costs associated with defense investment to generate variation in these traits. Our analysis comparing features of the intracellular immune-receptor repertoires with trait data of 187 species shows that in wild plants, the size of the molecular defense repertoire correlates negatively with growth. By contrast, we do not find evidence for a growth-defense trade-off in agricultural plants. Our cross-species approach highlights the central role of defense investment in shaping ecological trait variation and its sensitivity to domestication.},
}

@article{stephens2023insect,
    title = {Insect pollination for most of angiosperm evolutionary history},
    author = {Stephens, Ruby E. and Gallagher, Rachael V. and Dun, Lily P. and Cornwell, William K. and Sauquet, Hervé},
    year = {2023},
    journal = {New Phytologist},
    volume = {240},
    number = {2},
    pages = {880--891},
    issn = {0028-646X},
    doi = {10.1111/nph.18993},
    url = {https://doi.org/10.1111/nph.18993},
    language = {en},
    keywords = {insect pollination, angiosperm evolution, ancestral state reconstruction, wind pollination, pollination syndromes, macroevolution, leaf area index, latitude, plant-pollinator interactions},
    abstract = {Most contemporary angiosperms (flowering plants) are insect pollinated, but pollination by wind, water or vertebrates occurs in many lineages. Though evidence suggests insect pollination may be ancestral in angiosperms, this is yet to be assessed across the full phylogeny. Here, we reconstruct the ancestral pollination mode of angiosperms and quantify the timing and environmental associations of pollination shifts. We use a robust, dated phylogeny and species-level sampling across all angiosperm families to model the evolution of pollination modes. Data on the pollination system or syndrome of 1160 species were collated from the primary literature. Angiosperms were ancestrally insect pollinated, and insects have pollinated angiosperms for c. 86\% of angiosperm evolutionary history. Wind pollination evolved at least 42 times, with few reversals to animal pollination. Transitions between insect and vertebrate pollination were more frequent: vertebrate pollination evolved at least 39 times from an insect-pollinated ancestor with at least 26 reversals. The probability of wind pollination increases with habitat openness (measured by Leaf Area Index) and distance from the equator. Our reconstruction gives a clear overview of pollination macroevolution across angiosperms, highlighting the long history of interactions between insect pollinators and angiosperms still vital to biodiversity today.},
}

@article{zheng2024effects,
    title = {Effects of plant diversity on productivity strengthen over time due to trait-dependent shifts in species overyielding},
    author = {Zheng, Liting and Barry, Kathryn E. and Guerrero‐Ramírez, Nathaly R. and Craven, Dylan and Reich, Peter B. and Verheyen, Kris and Scherer‐Lorenzen, Michael and Eisenhauer, Nico and Barsoum, Nadia and Bauhus, Jürgen and Bruelheide, Helge and Cavender-Bares, Jeannine M. and Doležal, Jiří and Auge, Harald and Fagundes, Marina V. and Ferlian, Olga and Fiedler, Sebastian and Forrester, David Ian and Ganade, Gislene and Gebauer, Tobias and Haase, Josephine and Hajek, Peter and Hector, Andy and Hérault, Bruno and Hölscher, Dirk and Hulvey, Kristin B. and Irawan, Bambang and Jactel, Hervé and Koricheva, Julia and Kreft, Holger and Lanta, Vojtěch and Lepš, Jan and Mereu, Simone and Messier, Christian and Montagnini, Florencia and Mörsdorf, Martin Alfons and Müller, Sandra and Muys, Bart and Nock, Charles A. and Paquette, Alain and Parker, William C. and Parker, John D. and Parrotta, John A. and Paterno, Gustavo Brant and Perring, Michael Philip and Piotto, Daniel and Polley, H. Wayne and Ponette, Quentin and Potvin, Catherine and Quosh, Julius and Rewald, Boris and Godbold, Douglas L. and van Ruijven, Jasper and Standish, Rachel Jayne and Stefański, Artur and Sundawati, Leti and Urgoiti, Jon and Williams, Laura and Wilsey, Brian J. and Yang, Baiyu and Zhang, Li and Zhao, Zhao and Yang, Yongchuan and Sandén, Hans and Ebeling, Anne and Schmid, Bernhard and Fischer, Markus and Kotowska, Martyna M. and Palmborg, Cecilia and Tilman, David G. and Yan, En‐Rong and Hautier, Yann},
    year = {2024},
    journal = {Nature Communications},
    volume = {15},
    number = {1},
    pages = {2078},
    issn = {2041-1723},
    doi = {10.1038/s41467-024-46355-z},
    url = {https://doi.org/10.1038/s41467-024-46355-z},
    language = {en},
    keywords = {plant diversity, community productivity, functional traits, resource acquisition strategies, grassland, forests},
    abstract = {Plant diversity effects on community productivity often increase over time. Whether the strengthening of diversity effects is caused by temporal shifts in species-level overyielding (i.e., higher species-level productivity in diverse communities compared with monocultures) remains unclear. Here, using data from 65 grassland and forest biodiversity experiments, we show that the temporal strength of diversity effects at the community scale is underpinned by temporal changes in the species that yield. These temporal trends of species-level overyielding are shaped by plant ecological strategies, which can be quantitatively delimited by functional traits. In grasslands, the temporal strengthening of biodiversity effects on community productivity was associated with increasing biomass overyielding of resource-conservative species increasing over time, and with overyielding of species characterized by fast resource acquisition either decreasing or increasing. In forests, temporal trends in species overyielding differ when considering above- versus belowground resource acquisition strategies. Overyielding in stem growth decreased for species with high light capture capacity but increased for those with high soil resource acquisition capacity. Our results imply that a diversity of species with different, and potentially complementary, ecological strategies is beneficial for maintaining community productivity over time in both grassland and forest ecosystems.},
}

