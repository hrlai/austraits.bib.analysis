@Article{Richards_2021,
  year = {2021},
  author = {Jeannine H. Richards and Jonathan J. Henn and Quinn M. Sorenson and Mark A. Adams and Duncan D. Smith and Katherine A. McCulloh and Thomas J. Givnish},
  title = {{Mistletoes and their eucalypt hosts differ in the response of leaf functional traits to climatic moisture supply}},
  journal = {Oecologia},
